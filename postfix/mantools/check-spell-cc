#!/bin/sh

# Spellchecks comments in C source code. See mantools/comment.c for
# 'comment' source code.

LANG=C; export LANG

find . -name *.[hc] | xargs cat | comment | mantools/deroff | spell | grep -F -vxf proto/stop | grep -F -vxf proto/stop.spell-cc

