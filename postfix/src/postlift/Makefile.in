SHELL	= /bin/sh
SRCS	= postlift.c
OBJS	= postlift.o
HDRS	= 
TESTSRC	= 
DEFS	= -I. -I$(INC_DIR) -D$(SYSTYPE)
CFLAGS	= $(DEBUG) $(OPT) $(DEFS)
TESTPROG= 
PROG	= postlift
INC_DIR	= ../../include
LIBS	= ../../lib/lib$(LIB_PREFIX)global$(LIB_SUFFIX) \
	../../lib/lib$(LIB_PREFIX)util$(LIB_SUFFIX)

.c.o:;	$(CC) $(CFLAGS) -c $*.c

$(PROG): $(OBJS) $(LIBS)
	$(CC) $(CFLAGS) $(SHLIB_RPATH) -o $@ $(OBJS) $(LIBS) $(SYSLIBS)

$(OBJS): ../../conf/makedefs.out

Makefile: Makefile.in
	cat ../../conf/makedefs.out $? >$@

test:	$(TESTPROG)

tests: 

root_tests:

update: ../../libexec/$(PROG)

../../libexec/$(PROG): $(PROG)
	cp $(PROG) ../../libexec

clean:
	rm -f *.o *core $(PROG) $(TESTPROG) junk 

tidy:	clean

depend: $(MAKES)
	(sed '1,/^# do not edit/!d' Makefile.in; \
	set -e; for i in [a-z][a-z0-9]*.c; do \
	    $(CC) -E $(DEFS) $(INCL) $$i | grep -v '[<>]' | sed -n -e '/^# *1 *"\([^"]*\)".*/{' \
	    -e 's//'`echo $$i|sed 's/c$$/o/'`': \1/' \
	    -e 's/o: \.\//o: /' -e p -e '}' ; \
	done | LANG=C sort -u) | grep -v '[.][o][:][ ][/]' >$$$$ && mv $$$$ Makefile.in
	@$(EXPORT) make -f Makefile.in Makefile 1>&2

# do not edit below this line - it is generated by 'make depend'
postlift.o: ../../include/argv.h
postlift.o: ../../include/argv_attr.h
postlift.o: ../../include/asan_logger.h
postlift.o: ../../include/attr.h
postlift.o: ../../include/check_arg.h
postlift.o: ../../include/clean_env.h
postlift.o: ../../include/defs_for_main.h
postlift.o: ../../include/htable.h
postlift.o: ../../include/iostuff.h
postlift.o: ../../include/mail_conf.h
postlift.o: ../../include/mail_dict.h
postlift.o: ../../include/mail_params.h
postlift.o: ../../include/mail_parm_split.h
postlift.o: ../../include/mail_proto.h
postlift.o: ../../include/mail_task.h
postlift.o: ../../include/mail_version.h
postlift.o: ../../include/maillog_client.h
postlift.o: ../../include/msg.h
postlift.o: ../../include/msg_vstream.h
postlift.o: ../../include/mymalloc.h
postlift.o: ../../include/mypwd.h
postlift.o: ../../include/nvtable.h
postlift.o: ../../include/plift_clnt.h
postlift.o: ../../include/stringops.h
postlift.o: ../../include/sys_defs.h
postlift.o: ../../include/ubsan_logger.h
postlift.o: ../../include/vbuf.h
postlift.o: ../../include/vstream.h
postlift.o: ../../include/vstring.h
postlift.o: postlift.c
